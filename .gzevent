title: "FSeC-SS Attack Defense Playtest"
summary: "5 challenges across Web, Binary, Crypto and Blockchain"
content: |
  5 challenges across Web, Binary, Crypto and Blockchain


  Keep your service/hill healthy, patch the bugs, and (A&D) steal.

start: "2026-05-31T10:00:00+08:00"
end: "2026-05-31T22:00:00+08:00"

hidden: true               
practiceMode: true
acceptWithoutReview: true
teamMemberCountLimit: 3
containerCountLimit: 5

ad:
  tickSeconds: 300              # round length in seconds
  flagLifetimeTicks: 5         # ticks a planted flag stays submittable
  warmupSeconds: 600           # grace after start before scoring begins
  resetCooldownMinutes: 10      # min minutes between a team's self-resets
  allowSnapshotDownload: true